# Copiar a .env y completar. Nunca subir .env (ni copias .env.*) al repositorio.

# Entorno: en el VPS DEBE ser "production" (CORS estricto, emails reales,
# ADMIN_EMAILS y BREVO_PASS obligatorias).
NODE_ENV=production
PORT=5000

# PostgreSQL (única base de datos). Usá una contraseña sin caracteres
# especiales de URL o codificala con encodeURIComponent.
DATABASE_URL=postgresql://reqrdito_app:CAMBIAR@127.0.0.1:5432/reqrdito?schema=public

# Solo para tests (npm test): base de PRUEBAS independiente, local, con rol propio.
# Crearla con scripts/sql/crear-base-test.sql. El reset exige además
# ALLOW_TEST_DB_RESET=yes en la terminal (no la dejes fija en .env).
# TEST_DATABASE_URL=postgresql://reqrdito_test_user:CAMBIAR@127.0.0.1:5432/reqrdito_test

# Dominios (valores por defecto mostrados)
# FRONTEND_URL=https://www.reqrdito.com
# API_URL=https://api.reqrdito.com
# QR_RECUERDO_BASE=https://reqrdito.com   (no cambiar: lo usan los QR ya impresos)
# CORS_ORIGINS=https://reqrdito.com,https://www.reqrdito.com

# Autenticación
GOOGLE_CLIENT_ID=
# Al menos 32 caracteres aleatorios
JWT_SECRET=
# JWT_EXPIRES_IN=30m

# Administración: emails de cuentas de Google (separados por coma, sin espacios
# obligatorios; se comparan en minúsculas) con acceso al panel de llaveros.
# Debe ser el email con el que se inicia sesión con Google en admin-keychains.html.
# Vacío = nadie entra. Ejemplo: ADMIN_EMAILS=admin@example.com,otra@example.com
ADMIN_EMAILS=

# Módulo de eventos: deshabilitado temporalmente
EVENTS_ENABLED=false

# Mercado Pago. Fuera de producción solo se aceptan credenciales de prueba:
# TEST-... o las credenciales de producción (APP_USR-...) de una CUENTA DE PRUEBA vendedora
# (se verifica con Mercado Pago). La credencial de la cuenta real queda bloqueada.
MP_ACCESS_TOKEN=
# Para pruebas locales del webhook, API_URL debe apuntar a un túnel HTTPS (p. ej. ngrok)
# hacia este backend; si no, Mercado Pago notifica a producción.

# Email (SMTP Brevo). Fuera de producción se simulan salvo EMAIL_ENABLED=true.
BREVO_USER=
BREVO_PASS=
# EMAIL_ENABLED=true
# A dónde van las respuestas de los clientes (reqrdito.com no tiene casilla). Por defecto reqrdito@gmail.com
# EMAIL_REPLY_TO=

# API de conversiones de Meta (Purchase desde el webhook de pago). Sin las dos no se envía nada.
# El pixel del navegador está en los HTML del frontend: debe ser el mismo ID.
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# Solo para pruebas: código de la pestaña "Probar eventos" de Events Manager
# META_TEST_EVENT_CODE=

# Precio temporal de prueba (solo pack Individual, solo con NODE_ENV=production).
# Las tres son obligatorias; la fecha necesita zona horaria y como máximo 72 h desde ahora.
# Solo pagan el precio de prueba los recuerdos de las cuentas de Google listadas.
# Al vencer se vuelve solo al precio oficial. Para cortarlo antes: borrar las tres y reiniciar.
# PRECIO_PRUEBA_INDIVIDUAL_ARS=100
# PRECIO_PRUEBA_HASTA=2026-10-20T23:59:00-03:00
# PRECIO_PRUEBA_EMAILS=
