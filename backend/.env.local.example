# Entorno de pruebas LOCAL (npm run dev). Copiar a backend/.env.local y completar.
# .env.local se carga ENCIMA de .env: lo que se define acá pisa a .env solo en `npm run dev`.
# Nunca se versiona (está en .gitignore). Ver docs/PRUEBAS_LOCALES.md.

NODE_ENV=development
PORT=5000
FRONT_PORT=5500

# Base de pruebas manuales: SIEMPRE reqrdito_dev (el script se niega a usar otra).
# Mismo usuario y contraseña que DATABASE_URL de .env; solo cambia el nombre de la base.
DATABASE_URL=postgresql://reqrdito_app:CONTRASEÑA@localhost:5432/reqrdito_dev

# Archivos subidos en pruebas, separados de uploads/ (que tiene los archivos reales)
UPLOADS_DIR=uploads-dev

# Direcciones locales (redirecciones, links de emails y contenido de los QR)
FRONTEND_URL=http://localhost:5500
API_URL=http://localhost:5000
QR_RECUERDO_BASE=http://localhost:5500

# Mercado Pago: credencial de PRUEBA. Fuera de producción solo se aceptan:
#   - TEST-...  (credenciales de prueba de tu cuenta), o
#   - APP_USR-... de una CUENTA DE PRUEBA vendedora (se verifica con Mercado Pago).
# La credencial de tu cuenta real queda bloqueada (los pagos responden 503).
# MP_ACCESS_TOKEN=

# Opcional: túnel HTTPS (cloudflared/ngrok) hacia http://localhost:5000 para que
# Mercado Pago envíe el webhook. Sin túnel, pago-exito.html avisa al webhook local.
# MP_NOTIFICATION_URL=https://<tu-tunel>/api/webhook

# ffmpeg (convierte los audios subidos a MP3). Si no está en el PATH, indicar la ruta:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Emails: se simulan (se muestran en la consola). EMAIL_ENABLED=true los enviaría de verdad.
EMAIL_ENABLED=false

# Módulo de eventos apagado
EVENTS_ENABLED=false
